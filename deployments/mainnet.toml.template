# Mainnet deployment manifest TEMPLATE. Not a real deployment.
#
# This file documents the shape of deployments/mainnet.toml. The real manifest
# is produced at deploy time by scripts/record-deploy-provenance.sh from a
# CLEAN, committed revision, and only then committed to the repo. Placeholder
# values below are intentionally invalid so nothing here can be mistaken for a
# live deployment. Do not add private keys.
#
# To verify a real manifest reproduces from source:
#   scripts/verify-reproducible-build.sh \
#     --manifest deployments/mainnet.toml --commit <source_commit>

network = "mainnet"
network_passphrase = "Public Global Stellar Network ; September 2015"
source_repo = "https://github.com/PoulavBhowmick03/sidereal"
source_commit = "REPLACE_WITH_CLEAN_COMMIT_SHA"
deployer_identity = "sidereal-mainnet-deployer"
deployer_public_key = "REPLACE_WITH_DEPLOYER_PUBLIC_KEY"
deployed_at = "REPLACE_WITH_ISO8601_UTC"
maturity = 0
token_decimals = 7
yield_source = "blend"
blend_pool = "REPLACE_WITH_BLEND_POOL_ID"
underlying_asset = "USDC:REPLACE_WITH_ISSUER"

[build]
rust_toolchain = "1.96.0"
rustc = "REPLACE_WITH_RUSTC_VERSION_STRING"
stellar_cli = "REPLACE_WITH_STELLAR_CLI_VERSION_STRING"
soroban_sdk = "=26.1.0"
wasm_target = "wasm32v1-none"
optimizer = "stellar contract build (bundled wasm-opt)"

[curve]
scalar_root = "2000000000000000000"
initial_anchor = "1050000000000000000"
fee_bps = 10
twap_window = 1800

[contracts]
underlying = "REPLACE_WITH_UNDERLYING_ID"
sy_wrapper = "REPLACE_WITH_SY_ID"
pt_token = "REPLACE_WITH_PT_ID"
yt_token = "REPLACE_WITH_YT_ID"
tokenizer = "REPLACE_WITH_TOKENIZER_ID"
amm = "REPLACE_WITH_AMM_ID"

[wasm_hashes]
sy_wrapper = "REPLACE_WITH_SHA256"
pt_token = "REPLACE_WITH_SHA256"
yt_token = "REPLACE_WITH_SHA256"
tokenizer = "REPLACE_WITH_SHA256"
amm = "REPLACE_WITH_SHA256"

[onchain_hashes]
sy_wrapper = "REPLACE_WITH_SHA256"
pt_token = "REPLACE_WITH_SHA256"
yt_token = "REPLACE_WITH_SHA256"
tokenizer = "REPLACE_WITH_SHA256"
amm = "REPLACE_WITH_SHA256"
